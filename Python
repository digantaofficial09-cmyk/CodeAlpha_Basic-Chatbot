# -----------------------------------------
# Welcome Message
# -----------------------------------------
print("====================================")
print("        BASIC PYTHON CHATBOT")
print("====================================")
print("Type 'bye' to end the conversation.\n")

# -----------------------------------------
# Function to generate chatbot responses
# -----------------------------------------
def chatbot_response(user_message):

    # Convert user input to lowercase
    user_message = user_message.lower()

    # -----------------------------------------
    # Predefined chatbot responses
    # -----------------------------------------

    if user_message == "hello":
        return "Hi! Nice to meet you."

    elif user_message == "how are you":
        return "I'm fine, thanks for asking!"

    elif user_message == "what is your name":
        return "I am a simple Python chatbot."

    elif user_message == "who created you":
        return "I was created by Diganta Chakraborty."

    elif user_message == "bye":
        return "Goodbye! Have a great day."

    else:
        return "Sorry, I don't understand that."

# -----------------------------------------
# Main chatbot loop
# -----------------------------------------
while True:

    # Taking user input
    user_input = input("You : ")

    # Getting chatbot response
    response = chatbot_response(user_input)

    # Display chatbot response
    print("Bot :", response)

    # Exit condition
    if user_input.lower() == "bye":
        break

# =========================================================
# End of Program
